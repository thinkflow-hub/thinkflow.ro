# Supabase (required for CRM + analytics)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SMTP (contact form email notifications)
# Option A: Brevo (recommended — free, 300 emails/day)
# Use SMTP Key from Brevo → TP → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b13476001@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key

# Option B: Gmail App Password (requires 2FA + app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=thinkflowhub@gmail.com
# SMTP_PASS=your-gmail-app-password

CONTACT_EMAIL=thinkflowhub@gmail.com

# "Ask the News" AI answers (optional — feature degrades to plain keyword
# search results if unset). Uses OpenRouter's free-tier models, no cost.
# 20 req/min, 50/day (or 1000/day once $10+ in credits has ever been purchased).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
